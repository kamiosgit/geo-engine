# Normalise line endings so the plugin behaves identically on every OS.
* text=auto

*.php  text eol=lf
*.js   text eol=lf
*.css  text eol=lf
*.md   text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.txt  text eol=lf
*.pot  text eol=lf

*.zip binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.svg text eol=lf
